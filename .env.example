# Environment & Server
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL Database (Supports local Docker, Neon, Supabase, Render, AWS RDS)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/resolveops

# Redis Cache & Mutex (Supports redis:// and rediss:// TLS for Upstash)
REDIS_URL=redis://localhost:6379/0

# Security: HMAC Webhook Signing Secret
ADMIN_WEBHOOK_SECRET=your_admin_webhook_secret_here

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Business Rules Defaults
MAX_AUTO_REFUND_LIMIT_DEFAULT=100.00
RETURN_WINDOW_DAYS_DEFAULT=30
